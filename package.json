{
  "name": "ets2-overlay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "server": "node server/index.js",
    "dev:all": "concurrently --names \"SERVER,OVERLAY\" -c \"cyan,magenta\" \"npm run server\" \"npm run dev\""   
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "trucksim-telemetry": "^1.0.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "trucksim-telemetry@1.0.0": true
  }
